{
  "Cccxa": {
    "StorageRoot": "%LOCALAPPDATA%\\cccxa",

    "OnlyUsers": [],
    "ExcludeUsers": [],

    "Screenshot": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "Scale": 0.5,
      "MaxWidth": 1600,
      "JpegQuality": 40,
      "SkipWhenIdleSeconds": 120
    },

    "CaptureBrowserUrls": true,
    "CaptureProcesses": true,
    "CaptureForegroundWindows": true,
    "CaptureRecentFiles": true,

    "ScreenshotRetentionDays": 7,
    "DataRetentionDays": 30,
    "RetentionCheckHours": 6,

    "ImportBrowserHistory": true,
    "HistoryImportIntervalMinutes": 5,

    "ForegroundPollMs": 1000,
    "ProcessPollMs": 3000,

    "BrowserProcessNames": [ "chrome", "msedge", "brave", "opera", "vivaldi", "chromium" ],
    "BrowserAddressBarNames": [ "Address and search bar", "שורת הכתובת והחיפוש", "כתובת ושורת חיפוש" ]
  }
}
